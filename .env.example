# ============================================================================
#  IDREM TERESHKOVA — variables d'environnement (TOUTES OPTIONNELLES)
# ============================================================================
#  Le projet fonctionne avec seulement `config.json` + `account.txt`.
#  Ces variables servent à surcharger la configuration sans toucher aux fichiers.
#
#  Usage local :
#      cp .env.example .env        puis : node --env-file=.env index.js
#      ou directement :             PREFIX="!" npm start
#  « .env » est ignoré par Git (voir .gitignore).
#
#  Sur Render : ne créez PAS de fichier .env — renseignez ces valeurs dans
#  l'onglet « Environment » du service (les secrets en « sync: false »).
#
#  Aucune dépendance dotenv : tout est lu depuis process.env.
# ============================================================================

# ---------------------------------------------------------------------------
# Identité du bot
# ---------------------------------------------------------------------------
# development | production | test
NODE_ENV=production

# Nom affiché par le bot (/botinfo, /config, message « / »).
BOT_NAME=IDREM TERESHKOVA

# Nom court utilisé dans les encadrés (défaut : IDREM).
# BOT_SHORT_NAME=IDREM

# Langue des messages SYSTÈME (fr | en). Les commandes restent en français.
LANGUAGE=fr

# Préfixe des commandes (modifiable à chaud : /setprefix).
PREFIX=/

# ---------------------------------------------------------------------------
# Propriétaire et rôles
# ---------------------------------------------------------------------------
# UID Facebook du propriétaire : seul accès aux commandes « owner ».
OWNER_UID=100065927401614

# Compatibilité : si OWNER_UID est absent, ADMIN_UID est utilisé comme
# propriétaire. Préférez OWNER_UID.
# ADMIN_UID=100065927401614

# ⚠️ /eval est désactivé par défaut, et FORCÉMENT désactivé en production.
# Ne l'activez que si vous savez exactement ce que vous faites.
ALLOW_EVAL=false

# ---------------------------------------------------------------------------
# Journalisation
# ---------------------------------------------------------------------------
# silent | error | warn | info | debug
LOG_LEVEL=info

# Fichier journal optionnel (rotation à 5 Mo). Vide = console seule.
# LOG_FILE=data/bot.log

# Nombre d'entrées de journal conservées (/logs).
# LOG_RETENTION=200

# Désactive les couleurs ANSI.
# NO_COLOR=1

# ---------------------------------------------------------------------------
# Serveur de statut (obligatoire pour un Web Service Render)
# ---------------------------------------------------------------------------
# Render injecte PORT automatiquement : ne pas le fixer en production.
PORT=3000

# Render exige 0.0.0.0 (jamais 127.0.0.1).
HOST=0.0.0.0

# false = désactive le serveur HTTP (utile en Background Worker).
HEALTH_SERVER=true

# ---------------------------------------------------------------------------
# Compte Facebook (aucune valeur réelle ne doit arriver sur GitHub)
# ---------------------------------------------------------------------------
# Ordre de priorité :
#   ACCOUNT_FILE → account.txt → appstate.json → FB_APPSTATE → FB_COOKIE
#   → FB_EMAIL + FB_PASSWORD
#
# Sur Render le disque est ÉPHÉMÈRE : utilisez FB_APPSTATE (secret).

# Chemin personnalisé du fichier de compte.
# ACCOUNT_FILE=/etc/secrets/account.txt

# Contenu du compte : tableau JSON de cookies (appState) ou chaîne de cookies.
# FB_APPSTATE=[{"key":"c_user","value":"…","domain":".facebook.com","path":"/"}]

# Chaîne de cookies brute.
# FB_COOKIE=c_user=…; xs=…; datr=…; fr=…; sb=…

# Identifiants (⛔ déconseillé : checkpoints quasi systématiques).
# FB_EMAIL=
# FB_PASSWORD=
# FB_TWOFACTOR=

# ---------------------------------------------------------------------------
# Connexion (options de @dongdev/fca-unofficial)
# ---------------------------------------------------------------------------
# Tentatives de connexion avant abandon (1 à 10).
LOGIN_RETRIES=3

# Attente entre deux tentatives, en ms (multipliée par le n° d'essai).
LOGIN_RETRY_DELAY_MS=10000

# true = traiter aussi les messages envoyés par le bot lui-même (déconseillé).
SELF_LISTEN=false

# true = marquer automatiquement les messages reçus comme lus.
AUTO_MARK_READ=false

# true = apparaître « en ligne » sur Messenger.
ONLINE=true

# Proxy HTTP/SOCKS si votre hébergeur est bloqué par Facebook.
# PROXY=socks5://utilisateur:motdepasse@hote:1080

# User-Agent personnalisé (vide = celui de la librairie).
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ---------------------------------------------------------------------------
# Conversation naturelle
# ---------------------------------------------------------------------------
# true | false — réponses aux salutations, remerciements, questions simples.
CONVERSATION=true

# Probabilité de réponse en message privé (0 à 1). En groupe : moitié moins.
CONVERSATION_PROBABILITY=0.5

# ---------------------------------------------------------------------------
# Économie
# ---------------------------------------------------------------------------
CURRENCY_SYMBOL=IG
START_BALANCE=500

# ---------------------------------------------------------------------------
# Persistance des données
# ---------------------------------------------------------------------------
# Dossier des JSON (users, groups, settings, economy, warnings, stats, logs).
DATA_DIR=data

# Délai de regroupement des écritures disque (ms).
FLUSH_INTERVAL_MS=2000

# Fréquence du snapshot distant (ms). 0 = désactivé.
SNAPSHOT_INTERVAL_MS=300000

# ⚠️ Render perd le disque à chaque redéploiage. Pour conserver les données,
# pointez vers un stockage distant acceptant PUT/GET JSON (blob, KV, petit
# service HTTP), puis renseignez l'URL et le jeton.
# REMOTE_STORE_URL=https://mon-stockage.example.com/idrem/data
# REMOTE_STORE_TOKEN=
# REMOTE_STORE_HEADER=x-api-key

# ---------------------------------------------------------------------------
# IA texte (/ai /ask /summarize /explain /code)
# ---------------------------------------------------------------------------
# openai | groq | openrouter | compatible (endpoint /chat/completions)
# Sans clé, les commandes IA répondent « service non configuré » — jamais de
# réponse inventée.
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_BASE_URL=
# AI_MAX_TOKENS=700

# Raccourcis : une seule de ces clés suffit, le fournisseur est déduit.
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Génération d'images (/image)
# ---------------------------------------------------------------------------
# IMAGE_API_KEY=

# ---------------------------------------------------------------------------
# Médias (/yt /ytmp3 /ytmp4 /tiktok /instagram /play /lyrics /sticker)
# ---------------------------------------------------------------------------
# ⛔ Le bot ne contourne AUCUNE protection de plateforme. Le téléchargement
# passe uniquement par VOTRE service intermédiaire (API de download que vous
# hébergez et dont vous assumez les conditions d'utilisation). Sans MEDIA_API_URL,
# les commandes renvoient un message clair expliquant quoi configurer.
# MEDIA_API_URL=
# MEDIA_API_TOKEN=
# MEDIA_TIMEOUT_MS=20000
# MEDIA_MAX_BYTES=6291456

# Recherche YouTube par mots-clés (les liens directs fonctionnent sans clé).
# YOUTUBE_API_KEY=
