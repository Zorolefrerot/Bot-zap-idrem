###############################################################################
# IDREM TERESHKOVA BOT — variables d'environnement
# Copier ce fichier vers .env puis remplir les valeurs.
#   Commande :  cp .env.example .env
# Le fichier .env est EXCLU de Git (voir .gitignore). Ne jamais le commiter.
###############################################################################

# ---------------------------------------------------------------------------
# SERVEUR WEB
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Origines autorisées pour le CORS (frontend hébergé séparément :
# GitHub Pages, Vercel, Netlify...). Séparées par des virgules.
# Exemple : https://monuser.github.io,https://mon-bot.vercel.app
ALLOWED_ORIGINS=

# Autorise l'affichage du site dans une iframe (preview d'hébergeur).
# Passez à false en production pour durcir la protection anti-clickjacking.
ALLOW_EMBED=true

# ---------------------------------------------------------------------------
# SECURITE (obligatoire en production)
# ---------------------------------------------------------------------------
# Mot de passe du dashboard / de l'API.
# Si laissé vide, un mot de passe fort est généré au démarrage et AFFICHE
# UNE SEULE FOIS dans les logs du serveur (jamais dans le frontend).
DASHBOARD_PASSWORD=

# Secret utilisé pour signer les tokens de session du dashboard.
# Si vide, généré au démarrage (les sessions sont alors invalidées au restart).
SESSION_SECRET=

# Clé API optionnelle (header X-Api-Key) pour un accès machine-to-machine.
API_KEY=

# Limitation de débit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
PAIR_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# CHEMINS DE STOCKAGE
# ---------------------------------------------------------------------------
DATA_DIR=./data
SESSION_DIR=./sessions
LOG_DIR=./logs
TMP_DIR=./tmp
# Ecrire aussi les logs dans un fichier (true/false)
LOG_TO_FILE=true
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# CONFIGURATION DU BOT (valeurs par défaut)
# Ces valeurs sont modifiables depuis le dashboard et persistent en base.
# ---------------------------------------------------------------------------
BOT_NAME=IDREM TERESHKOVA BOT
PREFIX=/
STICKER_NAME=IDREM TERESHKOVA
# Auteur des stickers — par défaut : ADMIN_NAME
STICKER_AUTHOR=
ADMIN_NUMBER=
ADMIN_NAME=

# ---------------------------------------------------------------------------
# WHATSAPP / BAILEYS
# ---------------------------------------------------------------------------
# Nom affiché du device lors de l'appairage
WA_BROWSER_OS=Ubuntu
WA_BROWSER_NAME=IDREM Tereshkova
# Version WhatsApp forcée (ex: 2.3000.10232330003). Vide = dernière connue.
WA_VERSION=
# Connexion automatique au démarrage si une session valide existe
AUTO_RECONNECT=true
# Reconnexion automatique en cas de coupure réseau
AUTO_RETRY_ON_DISCONNECT=true
# Synchroniser tout l'historique (peut être lourd) — false recommandé
SYNC_FULL_HISTORY=false

# ---------------------------------------------------------------------------
# MEDIA (ffmpeg requis pour /tovideo, /toaudio et les stickers animés)
# ---------------------------------------------------------------------------
# Chemin absolu du binaire ffmpeg. Vide = recherche automatique (PATH,
# puis paquet optionnel ffmpeg-static).
FFMPEG_PATH=
