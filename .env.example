# ════════════════════════════════════════════════════════════
#  🧬 MeR~NeL — Configuration (copier vers .env et remplir)
#  ⚠️  Ne JAMAIS committer le fichier .env réel sur GitHub.
# ════════════════════════════════════════════════════════════

# ── Identité du bot ──
BOT_NAME=MeR~NeL
BOT_SIGNATURE=MeR~NeL Production
PREFIX=X

# ── Administrateurs (défauts intégrés dans core/config.js — optionnel) ──
# ADMIN_UIDS=61569333774600,100065927401614
# OWNER_UID=100065927401614

# ── IA : Xask / Xai (shizo) ──
SHIZO_API_URL=https://api.shizo.top/ai/gpt
SHIZO_API_KEY=shizo

# ── IA : Xchat (proxy gemini) ──
GEMINI_CHAT_URL=https://arychauhann.onrender.com/api/gemini-proxy2

# ── Images / Vidéos : Agnes AI ──
# Une clé par défaut est intégrée dans core/config.js : ces variables sont
# OPTIONNELLES — à remplir uniquement pour utiliser ta propre clé.
AGNES_API_URL=https://apihub.agnes-ai.com/v1
# AGNES_API_KEY=
AGNES_IMAGE_MODEL=dall-e-3

# ── Connexion Facebook (adapter ws3-fca) ──
# Cookie/appstate : soit un fichier appstate.json à la racine,
# soit la variable APPSTATE_JSON contenant le JSON complet des cookies.
APPSTATE_FILE=appstate.json
# APPSTATE_JSON=

# ── Serveur keep-alive (Render) ──
PORT=3000

# ── Économie ──
DAILY_REWARD=350
DAILY_COOLDOWN_HOURS=24
START_BALANCE=500

# ── Médias ──
MAX_IMAGES=5
MEDIA_MAX_SECONDS=120

# ── Jeux ──
QUIZ_TIMEOUT_MS=30000
DUEL_TIMEOUT_MS=25000
QUIZ_COINS_PER_CORRECT=15

# ── Anti-spam ──
SPAM_DUPLICATE_LIMIT=5
SPAM_TIME_WINDOW_MS=30000
SPAM_WARN_LIMIT=3
SPAM_MUTE_MINUTES=10

# ── Mode veille automatique (défauts intégrés) ──
IDLE_STANDBY_MINUTES=30
STANDBY_ANNOUNCE=true
