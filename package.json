{
  "name": "idrem-tereshkova-bot",
  "version": "1.0.0",
  "description": "IDREM TERESHKOVA BOT - Bot WhatsApp (Baileys) + dashboard web moderne : Pair Code, Session ID, stickers, /vv",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon --watch src --ext js,json --signal SIGTERM src/index.js",
    "dev:client": "npm --prefix frontend run dev",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend install --no-audit --no-fund && npm --prefix frontend run build",
    "test": "node --test tests/*.test.mjs",
    "doctor": "node scripts/doctor.js"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "bot",
    "idrem-tereshkova",
    "pair-code",
    "session-id",
    "sticker",
    "dashboard"
  ],
  "author": "IDREM TERESHKOVA",
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^9.1.1",
    "@whiskeysockets/baileys": "6.7.24",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "node-webpmux": "^3.2.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.9"
  },
  "overrides": {
    "libsignal": "6.0.0"
  }
}
